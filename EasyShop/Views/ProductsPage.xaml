<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EasyShop.Views.ProductsPage"
             Title="Produtos">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">
            <VerticalStackLayout Spacing="3">
                <Label Text="Catálogo de produtos" FontSize="25" FontAttributes="Bold" TextColor="#172033" />
                <Label Text="Produtos armazenados em documentos NoSQL com LiteDB." FontSize="13" TextColor="#64748B" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="11">
                    <Label Text="Cadastrar produto" FontSize="18" FontAttributes="Bold" TextColor="#172033" />
                    <Entry Placeholder="Nome do produto" Text="{Binding Name}" />
                    <Entry Placeholder="Preço (ex.: 129,90)" Text="{Binding Price}" Keyboard="Decimal" />
                    <Entry Placeholder="Categoria (opcional)" Text="{Binding Category}" />
                    <Entry Placeholder="Atributos (ex.: Cor: Azul; Tamanho: M)" Text="{Binding Attributes}" />
                    <Label Text="Os atributos são livres: cada produto pode ter características diferentes." FontSize="11" TextColor="#64748B" />
                    <Button Text="＋  Adicionar produto" Command="{Binding AddCommand}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Produtos cadastrados" FontSize="18" FontAttributes="Bold" TextColor="#172033" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Atualizar" FontSize="12" Padding="12,8" Command="{Binding RefreshCommand}" />
            </Grid>
            <Label Text="{Binding Message}" FontSize="12" TextColor="#2563EB" />
            <CollectionView ItemsSource="{Binding Products}" EmptyView="Ainda não há produtos cadastrados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="14" Margin="0,0,0,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#172033" />
                                    <Label Grid.Column="1" Text="{Binding Price, StringFormat='R$ {0:F2}'}" FontAttributes="Bold" TextColor="#16A34A" />
                                </Grid>
                                <Label Text="{Binding Category, StringFormat='Categoria: {0}'}" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding AttributesSummary}" FontSize="12" TextColor="#475569" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
