<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EasyShop.Views.CustomersPage"
             Title="Clientes">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">
            <VerticalStackLayout Spacing="3">
                <Label Text="Cadastro de clientes" FontSize="25" FontAttributes="Bold" TextColor="#172033" />
                <Label Text="Dados estruturados e relacionais armazenados com SQLite." FontSize="13" TextColor="#64748B" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="11">
                    <Label Text="Novo cliente" FontSize="18" FontAttributes="Bold" TextColor="#172033" />
                    <Entry Placeholder="Nome completo" Text="{Binding Name}" />
                    <Entry Placeholder="E-mail" Text="{Binding Email}" Keyboard="Email" />
                    <Label Text="O e-mail deve ser válido e não pode se repetir." FontSize="11" TextColor="#64748B" />
                    <Button Text="＋  Cadastrar cliente" Command="{Binding AddCommand}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Clientes cadastrados" FontSize="18" FontAttributes="Bold" TextColor="#172033" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Atualizar" FontSize="12" Padding="12,8" Command="{Binding RefreshCommand}" />
            </Grid>
            <Label Text="{Binding Message}" FontSize="12" TextColor="#2563EB" />
            <CollectionView ItemsSource="{Binding Customers}" EmptyView="Ainda não há clientes cadastrados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="14" Margin="0,0,0,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#172033" />
                                <Label Text="{Binding Email}" FontSize="13" TextColor="#64748B" />
                                <Label Text="{Binding Id, StringFormat='Código: #{0}'}" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
